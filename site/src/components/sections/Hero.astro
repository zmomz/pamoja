---
import HeroTree from './HeroTree.astro';

// The tree is the site's map. Each part carries the same number its section
// uses (01 Soil … 07 Seeds; 06, the grove, stands around the tree rather
// than on it), a persistent label, and the part's own colour — so the
// metaphor reads on first sight, on touch as well as with a mouse.
const hotspots = [
  { href: '#what-we-offer', num: '05', label: 'Canopy', part: 'canopy', aria: 'Go to What We Offer — the canopy', x: 50, y: 18, side: 'right' },
  { href: '#our-work', num: '04', label: 'Branches', part: 'branches', aria: 'Go to Our Work — the branches', x: 22, y: 42, side: 'right' },
  { href: '#who-we-are', num: '03', label: 'Trunk', part: 'trunk', aria: 'Go to Who We Are — the trunk', x: 51, y: 58, side: 'right' },
  { href: '#roots', num: '02', label: 'Roots', part: 'roots', aria: 'Go to Our Roots', x: 30, y: 87, side: 'right' },
  { href: '#ground', num: '01', label: 'Ground', part: 'ground', aria: 'Go to The Ground We Share', x: 76, y: 93, side: 'left' },
  { href: '#seeds', num: '07', label: 'Seeds', part: 'seeds', aria: "Go to What's Growing — seeds", x: 62, y: 79, side: 'left' },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="tag">Cultural Collective · Hamilton</p>
    <h1 id="hero-title">Pamoja<span class="period" aria-hidden="true">.</span></h1>
    <p class="lead">
      <em>Together</em> — building a city through relationship, cultural
      knowledge, creativity and mutual care.
    </p>
  </div>

  <div class="hero-tree-stage" id="hero-tree-stage">
    <HeroTree />
    {hotspots.map((h) => (
      <a
        class:list={['hotspot', `hotspot--${h.part}`, `hotspot--${h.side}`]}
        href={h.href}
        aria-label={h.aria}
        style={`left:${h.x}%;top:${h.y}%`}
      >
        <i aria-hidden="true"></i>
        <span class="hotspot-tag" aria-hidden="true">
          <span class="hotspot-num">{h.num}</span>
          {h.label}
        </span>
      </a>
    ))}
  </div>

  <p class="scroll-cue" aria-hidden="true">
    <span class="cue-long">Scroll down through the tree: ground, roots, trunk, branches, canopy, seeds ↓</span>
    <span class="cue-short">Scroll down through the tree ↓</span>
  </p>
</section>

<script is:inline>
  // Subtle 0.12× parallax on the tree within the first viewport, plus the
  // --hero-p descent the tree's own CSS listens for. Motion-gated; without
  // it the tree simply stands still. The stage is never centred by a
  // transform (mobile uses flow layout), so a bare translateY is safe.
  (function () {
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;
    var stage = document.getElementById('hero-tree-stage');
    var tree = document.getElementById('hero-tree');
    var hero = document.querySelector('.hero');
    if (!stage || !hero) return;
    var ticking = false;
    function update() {
      ticking = false;
      var y = window.scrollY;
      if (y < window.innerHeight) {
        stage.style.transform = 'translateY(' + y * 0.12 + 'px)';
      }
      if (tree) {
        var range = hero.offsetHeight || 1;
        tree.style.setProperty('--hero-p', Math.min(1, Math.max(0, y / range)).toFixed(3));
      }
    }
    window.addEventListener('scroll', function () {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    update();
  })();
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    margin-top: -4.5rem;
    padding-top: 4.5rem;
    overflow: hidden;
    background: linear-gradient(var(--cream) 0%, var(--paper) 55%, var(--cream) 100%);
  }
  /* The ground the tree stands in. A faint lift of karkadeh along its
     crest, settling into exactly --karkadeh-deep — the color the tree's
     soil mound sinks to — so the two meet without a seam. Two quiet
     strata lines keep it reading as ground rather than a colour block. */
  .hero::after {
    content: "";
    position: absolute;
    bottom: -14%;
    left: -8%;
    width: 116%;
    height: 32%;
    background:
      linear-gradient(180deg, transparent 0, transparent 34%, color-mix(in srgb, var(--ochre) 22%, transparent) 34.4%, transparent 35.2%),
      linear-gradient(180deg, transparent 0, transparent 58%, color-mix(in srgb, var(--ochre) 14%, transparent) 58.4%, transparent 59.2%),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--karkadeh) 28%, var(--karkadeh-deep)) 0%,
        var(--karkadeh-deep) 42%
      );
    border-radius: 50% 50% 0 0 / 40% 40% 0 0;
  }

  .hero-copy {
    position: absolute;
    z-index: 5;
    left: 6vw;
    top: 20%;
    max-width: 570px;
  }
  /* Clear the journey rail and its hero-state labels. */
  @media (min-width: 1150px) {
    .hero-copy { left: max(6vw, 132px); }
  }
  .hero-copy h1 .period {
    color: var(--hibiscus);
  }
  .lead {
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    max-width: 34ch;
    margin: 1.25rem 0 0;
    text-wrap: balance;
  }
  .lead em {
    font-family: var(--font-display);
    font-style: italic;
  }

  /* Sized by width and by height, so the crown never runs under the
     header on short, wide viewports. */
  .hero-tree-stage {
    position: absolute;
    right: 6%;
    bottom: 0;
    z-index: 3;
    width: min(640px, 56vw, 78vh);
    will-change: transform;
  }

  /* Hotspots: a small coloured mark plus a persistent numbered tag. The
     number matches the section numeral, the colour matches the part. */
  .hotspot {
    --part: var(--river);
    position: absolute;
    z-index: 6;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    transform: translate(-9px, -50%);
    text-decoration: none;
    color: var(--ink);
  }
  .hotspot--left {
    flex-direction: row-reverse;
    transform: translate(calc(-100% + 9px), -50%);
  }
  .hotspot--ground { --part: var(--ochre); }
  .hotspot--roots { --part: var(--karkadeh); }
  .hotspot--trunk { --part: var(--karkadeh-deep); }
  .hotspot--branches { --part: var(--river-deep); }
  .hotspot--canopy { --part: var(--river); }
  .hotspot--seeds { --part: var(--hibiscus); }
  .hotspot i {
    flex: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--part);
    border: 3px solid var(--paper);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--part) 55%, transparent);
    transition: transform 0.25s ease;
  }
  .hotspot-tag {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.28rem 0.6rem 0.28rem 0.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    border: 1px solid var(--line);
    font-family: var(--font-ui);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .hotspot-num {
    color: var(--part);
  }
  .hotspot:hover .hotspot-tag,
  .hotspot:focus-visible .hotspot-tag {
    transform: translateY(-2px);
    border-color: var(--part);
    box-shadow: 0 8px 18px color-mix(in srgb, var(--night) 14%, transparent);
  }
  .hotspot:hover i,
  .hotspot:focus-visible i {
    transform: scale(1.2);
  }
  .hotspot:focus-visible {
    outline: none;
  }
  .hotspot:focus-visible .hotspot-tag {
    outline: 3px solid var(--hibiscus);
    outline-offset: 2px;
  }

  /* The scroll cue names the journey. It bobs, and the bob keeps the
     centring transform (--cue-x) instead of replacing it. */
  .scroll-cue {
    --cue-x: 0px;
    position: absolute;
    z-index: 8;
    bottom: 30px;
    left: 6vw;
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper);
    max-width: none;
    animation: cue-pulse 2.6s ease-in-out infinite;
  }
  .cue-short { display: none; }

  @keyframes cue-pulse {
    0%, 100% { transform: translate(var(--cue-x), 0); }
    50% { transform: translate(var(--cue-x), 6px); }
  }

  @media (max-width: 850px) {
    /* Flow layout on one column: copy, then the tree, no dead band between
       them and no tree cut off under a chip. */
    .hero {
      min-height: auto;
      padding-top: calc(4.5rem + 1.75rem);
      padding-bottom: 5.5rem;
    }
    .hero-copy {
      position: relative;
      left: auto;
      top: auto;
      margin: 0 7vw;
      max-width: none;
    }
    .lead {
      max-width: 32ch;
      margin-top: 0.9rem;
    }
    .hero-tree-stage {
      position: relative;
      right: auto;
      bottom: auto;
      width: min(100%, 520px);
      margin: 1.5rem auto 0;
    }
    .hotspot-tag {
      font-size: 0.6rem;
      padding: 0.22rem 0.5rem 0.22rem 0.45rem;
    }
    .hotspot i { width: 15px; height: 15px; }
    .scroll-cue {
      --cue-x: -50%;
      left: 50%;
      bottom: 4.25rem; /* clears the 'On the tree' chip (14px + 42px) */
      width: max-content;
      max-width: calc(100vw - 2rem);
      text-align: center;
    }
    .cue-long { display: none; }
    .cue-short { display: inline; }
    .hotspot--canopy { left: 54% !important; top: 16% !important; }
    .hotspot--branches { left: 20% !important; top: 40% !important; }
    .hotspot--trunk { left: 53% !important; top: 56% !important; }
    .hotspot--roots { left: 26% !important; top: 88% !important; }
    .hotspot--ground { left: 82% !important; top: 94% !important; }
    .hotspot--seeds { left: 62% !important; top: 77% !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue { animation: none; transform: translate(var(--cue-x), 0); }
    .hotspot i, .hotspot-tag { transition: none; }
  }
</style>
