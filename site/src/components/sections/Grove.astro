---
// 06 · Grove — Who We Grow With. Copy and partner groups from the former
// /who-we-grow-with page; the connected-trees scene is ported from the
// prototype, recolored. The old hardcoded "Editorial placeholder" box is
// gone: the settlement-sector block renders only when real entries exist.
import { getPartners, type PartnerType } from '../../lib/data';

const partners = await getPartners();

const groups: { type: PartnerType; heading: string; intro: string }[] = [
  {
    type: 'partner',
    heading: 'Partners',
    intro:
      'Organizations that build with Pamoja — co-creating gatherings, giving space, and sharing ground.',
  },
  {
    type: 'ally',
    heading: 'Allies',
    intro:
      'People and organizations who walk alongside the work without steering it.',
  },
  {
    type: 'funder',
    heading: 'Funders',
    intro:
      'Municipal, corporate, and arts funders whose support made specific gatherings possible.',
  },
];

const grouped = groups
  .map((group) => ({
    ...group,
    members: partners.filter((p) => p.type === group.type),
  }))
  .filter((group) => group.members.length > 0);

const settlementPartners = partners.filter(
  (p) => p.type === 'settlement-sector'
);

// Up to five partners float over the art as chips opening the shared
// popover; the full record with contributions is in the groups below.
const chipSlots = ['gc1', 'gc2', 'gc3', 'gc4', 'gc5'];
const chipPartners = partners.slice(0, chipSlots.length);
---

<section id="who-we-grow-with" class="journey journey--tinted" data-number="06" aria-labelledby="who-we-grow-with-title">
  <div class="art reveal">
    <div class="grove-scene">
      <svg viewBox="0 0 540 400" role="img" aria-label="Three trees connected by roots below ground">
        <defs>
          <linearGradient id="grove-soil" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" style="stop-color: var(--karkadeh)" />
            <stop offset="1" style="stop-color: var(--karkadeh-deep)" />
          </linearGradient>
          <radialGradient id="grove-leaf-1" cx="0.4" cy="0.3" r="0.9">
            <stop offset="0" style="stop-color: var(--river-pale)" />
            <stop offset="1" style="stop-color: var(--river-deep)" />
          </radialGradient>
          <radialGradient id="grove-leaf-2" cx="0.35" cy="0.3" r="0.9">
            <stop offset="0" style="stop-color: var(--river-pale)" />
            <stop offset="1" style="stop-color: var(--river)" />
          </radialGradient>
          <radialGradient id="grove-leaf-3" cx="0.45" cy="0.3" r="0.9">
            <stop offset="0" style="stop-color: var(--river-light)" />
            <stop offset="1" style="stop-color: var(--river-deep)" />
          </radialGradient>
        </defs>

        <path d="M20 356 Q270 332 520 356 L520 400 L20 400Z" fill="url(#grove-soil)" />

        <g class="fade-in flow" fill="none" style="stroke: var(--ochre-light)" stroke-width="3" stroke-dasharray="2 12" stroke-linecap="round">
          <path d="M120 368 C200 350 340 350 420 368" />
          <path d="M120 378 C210 364 330 364 420 378" />
          <path d="M140 388 C220 376 320 376 400 388" />
        </g>

        <g>
          <path class="draw" d="M112 356 C110 300 108 260 112 216" fill="none" style="stroke: var(--karkadeh-deep)" stroke-width="11" stroke-linecap="round" />
          <g class="grow g1" style="transform-origin: 112px 188px">
            <path d="M112 148 C152 146 180 170 178 204 C176 238 148 256 112 252 C76 256 48 238 46 204 C44 170 72 146 112 148Z" fill="url(#grove-leaf-1)" />
            <path d="M112 158 C142 156 164 176 162 204 C160 232 138 248 112 244 C86 248 64 232 62 204 C60 176 82 156 112 158Z" fill="url(#grove-leaf-3)" opacity="0.7" />
          </g>
          <g style="fill: var(--river-light)" opacity="0.5">
            <path class="realistic-leaf" d="M90 180 C95 176 104 177 106 182 C102 187 95 186 90 182Z" />
            <path class="realistic-leaf rl2" d="M130 170 C135 166 144 167 146 172 C142 177 135 176 130 172Z" />
          </g>
        </g>
        <g>
          <path class="draw" d="M268 356 C266 280 264 220 268 148" fill="none" style="stroke: var(--karkadeh-deep)" stroke-width="13" stroke-linecap="round" />
          <g class="grow g2" style="transform-origin: 268px 112px">
            <path d="M268 48 C320 46 358 78 356 122 C354 166 318 186 268 182 C218 186 182 166 180 122 C178 78 216 46 268 48Z" fill="url(#grove-leaf-2)" />
            <path d="M268 60 C310 58 342 84 340 122 C338 160 310 178 268 174 C226 178 198 160 196 122 C194 84 226 58 268 60Z" fill="url(#grove-leaf-1)" opacity="0.75" />
          </g>
          <g style="fill: var(--river-light)" opacity="0.5">
            <path class="realistic-leaf" d="M240 90 C245 86 254 87 256 92 C252 97 245 96 240 92Z" />
            <path class="realistic-leaf rl2" d="M290 80 C295 76 304 77 306 82 C302 87 295 86 290 82Z" />
            <path class="realistic-leaf rl3" d="M268 100 C273 96 282 97 284 102 C280 107 273 106 268 102Z" />
          </g>
        </g>
        <g>
          <path class="draw" d="M418 356 C416 310 414 278 418 238" fill="none" style="stroke: var(--karkadeh-deep)" stroke-width="10" stroke-linecap="round" />
          <g class="grow g3" style="transform-origin: 418px 210px">
            <path d="M418 170 C452 168 476 190 474 220 C472 250 448 266 418 262 C388 266 364 250 362 220 C360 190 384 168 418 170Z" fill="url(#grove-leaf-3)" />
            <path d="M418 180 C444 178 464 196 462 220 C460 244 440 258 418 254 C396 258 376 244 374 220 C372 196 392 178 418 180Z" fill="url(#grove-leaf-2)" opacity="0.8" />
          </g>
          <g style="fill: var(--river-light)" opacity="0.5">
            <path class="realistic-leaf" d="M400 200 C405 196 414 197 416 202 C412 207 405 206 400 202Z" />
            <path class="realistic-leaf rl2" d="M440 190 C445 186 454 187 456 192 C452 197 445 196 440 192Z" />
          </g>
        </g>

        <g fill="none" style="stroke: var(--ochre)" stroke-width="2" opacity="0.5">
          <path d="M112 340 C180 332 240 336 268 340" stroke-dasharray="4 8" />
          <path d="M268 340 C320 336 380 332 418 340" stroke-dasharray="4 8" />
        </g>
      </svg>
      {chipPartners.map((partner, i) => (
        <button
          type="button"
          class={`chip chip-float grove-chip ${chipSlots[i]}${i > 0 ? ` d${i + 1}` : ''}`}
          data-popover-title={partner.name}
          data-popover-body={partner.contribution}
        >
          {partner.name}
        </button>
      ))}
    </div>
  </div>
  <div class="copy">
    <p class="tag reveal">06 · The grove</p>
    <h2 class="reveal" data-d="1" id="who-we-grow-with-title">Who We Grow With</h2>
    <p class="reveal" data-d="2">
      A tree doesn't grow alone. Around Pamoja stands a grove — partners,
      allies, and funders — each named here with what they actually
      contributed. Not a wall of logos: a record of relationships.
    </p>
    <p class="reveal" data-d="3">
      Settlement organizations are collaborators, not competitors. Their work
      makes this practice possible while Pamoja contributes something
      distinct.
    </p>
    <a class="cta reveal" data-d="4" href="#seeds">See what's growing →</a>
  </div>

  <div class="grove-groups" style="grid-column: 1 / -1">
    {grouped.map((group) => (
      <section class="grove-group" aria-labelledby={`group-${group.type}`}>
        <h3 class="reveal" id={`group-${group.type}`}>{group.heading}</h3>
        <p class="reveal" data-d="1">{group.intro}</p>
        <ul class="partner-list">
          {group.members.map((partner) => (
            <li class="partner reveal">
              <h4>
                {partner.url ? (
                  <a href={partner.url} rel="noopener">{partner.name}</a>
                ) : (
                  partner.name
                )}
              </h4>
              <p>{partner.contribution}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {settlementPartners.length > 0 && (
      <section class="grove-group" aria-labelledby="settlement-heading">
        <h3 class="reveal" id="settlement-heading">The settlement sector: distinct, not competing.</h3>
        <p class="reveal" data-d="1">
          Elsewhere on this site we draw a clear line between Pamoja and
          settlement organizations. This is where we show the line is not a wall.
          Hamilton's settlement organizations do essential work — work that makes
          ours possible — and we collaborate with them respectfully. Their
          direction is services delivered to people who need them; ours is
          building the city with the people who carry its missing knowledge.
          Different directions, same city, no competition for the same ground.
        </p>
        <ul class="partner-list">
          {settlementPartners.map((partner) => (
            <li class="partner reveal">
              <h4>
                {partner.url ? (
                  <a href={partner.url} rel="noopener">{partner.name}</a>
                ) : (
                  partner.name
                )}
              </h4>
              <p>{partner.contribution}</p>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>

  <p class="closing-line reveal" style="grid-column: 1 / -1">
    If your organization belongs in this grove, the way in is the same as
    every other way in: <a href="#contact">a conversation</a>.
  </p>
</section>

<style>
  .grove-scene {
    position: relative;
    width: min(540px, 90vw);
  }
  .grove-chip {
    font-size: 0.72rem;
    padding: 0.45rem 0.85rem;
  }
  .gc1 { left: -6px; top: 0; }
  .gc2 { right: -6px; top: 16%; }
  .gc3 { left: 30%; top: -6%; }
  .gc4 { left: 20%; bottom: -4%; }
  .gc5 { right: 2%; bottom: 0; }

  .grove-groups {
    display: grid;
    gap: 2.5rem;
  }
  .grove-group h3 {
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
    margin: 0 0 0.75rem;
  }
  .grove-group > p {
    margin: 0;
  }

  .partner-list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
  }
  .partner {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 1.5rem;
  }
  .partner h4 {
    font-family: var(--font-display);
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
    color: var(--night);
  }
  .partner p {
    margin: 0;
    font-size: 0.98rem;
  }

  .closing-line {
    font-size: 1.15rem;
    max-width: var(--max-prose);
    margin: 0;
  }

  @media (max-width: 850px) {
    .gc1 { left: 0; }
    .gc2 { right: 0; }
    .gc3 { left: 24%; }
    .gc5 { right: 0; }
  }
</style>
