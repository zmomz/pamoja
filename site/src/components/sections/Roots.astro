---
// 02 · Roots — Our Roots. Copy from the former /roots page; the root-system
// scene is ported from the prototype, recolored (karkadeh roots reaching
// through the shared ground, river-green growing tips). Ta'aruf and Takaful
// float over the art as word-chips opening the shared popover.
---

<section id="roots" class="journey journey--tinted" data-number="02" aria-labelledby="roots-title">
  <div class="art reveal">
    <div class="roots-scene">
      <svg viewBox="0 0 440 480" role="img" aria-label="Deep root system spreading through soil layers">
        <defs>
          <radialGradient id="roots-glow" cx="0.5" cy="0.9" r="0.8">
            <stop offset="0" style="stop-color: var(--karkadeh)" stop-opacity="0.22" />
            <stop offset="1" style="stop-color: var(--karkadeh)" stop-opacity="0" />
          </radialGradient>
          <linearGradient id="roots-fade-x" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#fff" stop-opacity="0" />
            <stop offset="0.18" stop-color="#fff" stop-opacity="1" />
            <stop offset="0.82" stop-color="#fff" stop-opacity="1" />
            <stop offset="1" stop-color="#fff" stop-opacity="0" />
          </linearGradient>
          <mask id="roots-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="440" height="480">
            <rect width="440" height="480" fill="url(#roots-fade-x)" />
          </mask>
        </defs>

        {/* Soil glow and strata fade at the sides — no box behind the roots. */}
        <g mask="url(#roots-mask)">
          <rect x="0" y="200" width="440" height="280" fill="url(#roots-glow)" />
          <path d="M0 200 Q220 190 440 200" fill="none" class="st-ochre" stroke-width="2" opacity="0.4" />
          <path d="M0 280 Q220 270 440 280" fill="none" class="st-ochre" stroke-width="2" opacity="0.3" />
          <path d="M0 360 Q220 350 440 360" fill="none" class="st-ochre" stroke-width="2" opacity="0.2" />
        </g>

        <path class="draw st-karkadeh-deep" d="M214 12 C210 90 218 170 216 252 C216 300 214 340 218 380 C220 410 224 430 228 450" fill="none" stroke-width="16" stroke-linecap="round" />

        <path class="draw st-karkadeh-deep" d="M216 250 C155 282 98 306 36 336" fill="none" stroke-width="9" stroke-linecap="round" />
        <path class="draw st-karkadeh-deep" d="M216 250 C274 286 332 304 398 324" fill="none" stroke-width="9" stroke-linecap="round" />
        <path class="draw st-karkadeh" d="M216 252 C184 314 146 358 100 404" fill="none" stroke-width="7" stroke-linecap="round" />
        <path class="draw st-karkadeh" d="M216 252 C248 316 290 358 338 406" fill="none" stroke-width="7" stroke-linecap="round" />

        <path class="draw st-karkadeh" d="M120 300 C98 336 76 358 46 382" fill="none" stroke-width="5" stroke-linecap="round" opacity="0.85" />
        <path class="draw st-karkadeh" d="M300 304 C322 340 348 364 378 388" fill="none" stroke-width="5" stroke-linecap="round" opacity="0.85" />
        <path class="draw st-karkadeh-deep" d="M216 320 C214 370 212 410 216 440" fill="none" stroke-width="6" stroke-linecap="round" opacity="0.8" />

        <g fill="none" class="st-ochre" stroke-width="1.5" opacity="0.5">
          <path d="M80 340 l-6 8 M90 348 l-4 10 M100 354 l-8 6" />
          <path d="M360 344 l6 8 M350 352 l4 10 M340 358 l8 6" />
          <path d="M180 380 l-5 8 M190 388 l-3 10 M200 394 l-7 6" />
          <path d="M260 384 l5 8 M250 392 l3 10 M240 398 l7 6" />
        </g>

        <g class="fade-in st-ochre" fill="none" stroke-width="2.5" stroke-dasharray="3 14" stroke-linecap="round" opacity="0.7">
          <path d="M216 262 C170 290 120 310 60 332" />
          <path d="M216 262 C262 292 314 308 376 326" />
          <path d="M217 330 C216 372 216 408 220 436" />
        </g>

        <g class="fade-in">
          <circle class="grow g2 tip f-river" cx="100" cy="404" r="8" style="transform-origin: 100px 404px" />
          <circle class="grow g3 tip f-river" cx="338" cy="406" r="8" style="transform-origin: 338px 406px" />
          <circle class="grow g4 tip f-river" cx="228" cy="450" r="7" style="transform-origin: 228px 450px" />
          <circle class="grow g1 tip f-river-light" cx="46" cy="382" r="6" style="transform-origin: 46px 382px" />
          <circle class="grow g1 tip f-river-light" cx="378" cy="388" r="6" style="transform-origin: 378px 388px" />
        </g>

        <g class="f-ochre" opacity="0.4">
          <circle cx="80" cy="280" r="3" /><circle cx="350" cy="310" r="2.5" /><circle cx="200" cy="340" r="2" />
        </g>
        <g class="f-ochre" opacity="0.3">
          <circle cx="300" cy="260" r="2" /><circle cx="120" cy="320" r="3" /><circle cx="380" cy="360" r="2.5" />
        </g>
        <g class="f-ochre" opacity="0.35">
          <circle cx="180" cy="290" r="2.5" /><circle cx="400" cy="280" r="2" /><circle cx="60" cy="360" r="3" />
        </g>
      </svg>
      <button
        type="button"
        class="chip chip--word chip-float roots-chip-taaruf"
        data-popover-title="Ta'aruf"
        data-popover-body="The practice of coming to know one another properly: over coffee or tea, through stories, at a pace trust requires. It treats every person as a knowledge holder, not a case — our ways of knowing are ours, shared as hosts, not as specimens."
      >Ta'aruf</button>
      <button
        type="button"
        class="chip chip--word chip-float d2 roots-chip-takaful"
        data-popover-title="Takaful"
        data-popover-body="The practice of carrying one another economically: fair honorariums for knowledge holders, transparent money, and decisions about resources made by the collective rather than over it. What we build, we build to be shared and to last."
      >Takaful</button>
    </div>
  </div>
  <div class="copy">
    <p class="tag reveal">02 · Roots</p>
    <h2 class="reveal" data-d="1" id="roots-title">Our Roots</h2>
    <p class="reveal" data-d="2">
      The soil is shared; the roots are ours. Ta'aruf and Takaful are
      traditions from our own cultures — the ethics newcomer Canadians of
      African Muslim origin carry and practise. They reach down into the
      common ground and draw nourishment from the covenants they resonate
      with, without ever claiming to be those covenants.
    </p>
    <a class="cta reveal" data-d="3" href="#who-we-are">See the trunk →</a>
  </div>

  <div class="root-cards block" aria-label="The two roots">
    <article class="card reveal" data-d="1">
      <figure class="glyph" aria-hidden="true">
        <svg viewBox="0 0 120 72" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <circle cx="42" cy="36" r="22" />
          <circle cx="78" cy="36" r="22" />
        </svg>
      </figure>
      <p class="tag">Epistemic sovereignty</p>
      <h3>Ta'aruf</h3>
      <p class="root-essence">
        Hospitality that builds ethical, dialogical relationship — that
        protects dignity and upholds difference without erasure.
      </p>
      <p>
        Ta'aruf is the practice of coming to know one another properly: over
        coffee or tea, through stories, at a pace trust requires. It treats
        every person as a knowledge holder, not a case. It is why Pamoja
        starts every engagement with conversation and why we do not move
        fast.
      </p>
      <p>
        As epistemic sovereignty, Ta'aruf means our ways of knowing are ours:
        carried, practised, and taught on our own terms, and shared — when we
        choose to share them — as hosts, not as specimens.
      </p>
      <p class="draws-from">
        Draws from the ground it resonates with:
        <a href="#ground">the Two Row Wampum</a> — two paths travelled side by
        side, difference without erasure. Ta'aruf and the Two Row meet in the
        ground; they are not the same thing, and Pamoja claims only its own
        root.
      </p>
    </article>

    <article class="card reveal" data-d="2">
      <figure class="glyph" aria-hidden="true">
        <svg viewBox="0 0 120 72" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M26 30 c0 16 15 26 34 26 s34 -10 34 -26" />
          <path d="M18 48 l9 9 M102 48 l-9 9" />
          <path d="M52 64 h16" />
        </svg>
      </figure>
      <p class="tag">Economic solidarity</p>
      <h3>Takaful</h3>
      <p class="root-essence">
        Mutual economic empowerment and collective stewardship — prosperity
        held in common, not extracted from it.
      </p>
      <p>
        Takaful is the practice of carrying one another economically: fair
        honorariums for knowledge holders, transparent money, and decisions
        about resources made by the collective rather than over it. It is why
        Pamoja asks partners what they are bringing besides money — and why we
        answer the same question ourselves.
      </p>
      <p>
        As economic solidarity, Takaful refuses the scarcity story told about
        newcomer communities. What we build, we build to be shared and to
        last.
      </p>
      <p class="draws-from">
        Draws from the ground it resonates with:
        <a href="#ground">the Dish With One Spoon Wampum</a> — take only what
        you need, leave some for others, keep the dish clean. Takaful and the
        Dish meet in the ground; they are not the same thing, and Pamoja
        claims only its own root.
      </p>
    </article>
  </div>

  <div class="how-we-work block-split">
    <div class="block-head">
      <h3 class="reveal">How we work.</h3>
    </div>
    <div class="how-grid block-body">
      <div class="reveal" data-d="1">
        <h4>Internally: consensus-based, self-determined</h4>
        <p>
          Pamoja decides by consensus. No one's work is directed from above,
          and no one's knowledge is spoken for by someone else. This is slower
          than a chain of command and sturdier than one — decisions made
          together hold together. The collective is self-determined: our
          agenda is set by the community that carries the work, not by a
          funder's cycle or an institution's calendar.
        </p>
      </div>
      <div class="reveal" data-d="2">
        <h4>In partnership: mutual consultation and dialogue</h4>
        <p>
          With partners, we practise mutual consultation — real dialogue
          before decisions, shared leadership during the work, and credit
          shared publicly after it. Partners do not commission a community
          from us; they enter a relationship with one. That is the shape of
          every engagement on <a href="#what-we-offer">What We Offer</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* The root system carries this section — give it a full half of the grid. */
  @media (min-width: 851px) {
    #roots {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 5vw;
    }
  }
  .roots-scene {
    position: relative;
    width: min(560px, 88vw);
  }
  .roots-scene svg {
    max-width: none;
  }
  .roots-chip-taaruf { left: -10px; top: 110px; }
  .roots-chip-takaful { right: -10px; top: 250px; }

  .root-cards {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    align-items: stretch;
  }
  .root-cards .card {
    display: flex;
    flex-direction: column;
  }
  .root-cards .glyph {
    margin: 0 0 1.25rem;
    color: var(--ochre);
    max-width: 120px;
  }
  .root-cards h3 {
    font-size: 2.1rem;
    margin: 0 0 0.75rem;
  }
  .root-essence {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--night);
  }
  .root-cards p {
    margin: 0 0 1rem;
  }
  .draws-from {
    margin-top: auto;
    margin-bottom: 0;
    padding: 1rem 0 0;
    border-top: 1px dashed var(--line);
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .how-we-work h3 {
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
    margin: 0 0 1.5rem;
  }
  .how-grid {
    display: grid;
    gap: 2rem;
  }
  .how-grid h4 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 0 0 0.6rem;
    color: var(--night);
  }
  .how-grid p {
    margin: 0;
  }

  @media (max-width: 850px) {
    .roots-chip-taaruf { left: 0; top: 80px; }
    .roots-chip-takaful { right: 0; top: 210px; }
  }
</style>
