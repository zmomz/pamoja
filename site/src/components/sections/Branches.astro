---
// 04 · Branches — Our Work. The four branches from the data layer as a 2×2
// grid of cards; each card is a link to the archive below carrying
// data-branch-target, which the Archive section's script turns into a filter
// action (without JS it simply jumps to the archive).
import { getBranches } from '../../lib/data';

const branches = await getBranches();
---

<section id="our-work" class="journey journey--tinted" data-number="04" aria-labelledby="our-work-title">
  {/* This stop breaks the art/copy pair: the heading and lead take the
      first row, and the four branches get the full width below so each card
      has room to read. */}
  <div class="copy block-split our-work-intro">
    <div class="block-head">
      <p class="tag reveal">04 · Branches</p>
      <h2 class="reveal" data-d="1" id="our-work-title">Our Work</h2>
    </div>
    <div class="block-body">
      <p class="reveal" data-d="2">
        Everything Pamoja grows hangs off four branches. They overlap on
        purpose: an event can build connection, strengthen cohesion, deepen a
        partnership, and link existing efforts at the same time. The filter
        below shows the overlap rather than hiding it.
      </p>
      <a class="cta reveal" data-d="3" href="#archive">Explore the archive →</a>
    </div>
  </div>
  <div class="branch-grid block">
      {branches.map((branch, i) => (
        <a
          class="branch-card reveal"
          data-d={String(i + 1)}
          href={`?serves=${branch.slug}#archive`}
          data-branch-target={branch.slug}
          aria-label={`${branch.title} — see the gatherings that served it`}
        >
          <span class="branch-num" aria-hidden="true">
            Branch {String(i + 1).padStart(2, '0')}
          </span>
          <h3>{branch.title}</h3>
          <p>{branch.description}</p>
          <span class="go">Gatherings that served {branch.title.toLowerCase()} →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  #our-work {
    min-height: 0;
    align-content: start;
    row-gap: 3rem;
    /* The intro's body sits in the right column, where the ghost numeral
       lives; start the content below it. */
    padding-top: max(13vh, 12.5rem);
  }
  #our-work::before {
    top: 3vh;
  }
  .our-work-intro .block-head { position: static; }
  .branch-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    width: 100%;
  }
  .branch-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-top: 3px solid var(--river);
    border-radius: 18px;
    background: color-mix(in srgb, var(--white) 55%, transparent);
    min-height: 160px;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.35s ease, box-shadow 0.35s ease, background 0.35s ease;
  }
  .branch-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 14px 28px color-mix(in srgb, var(--night) 10%, transparent);
    background: var(--white);
  }
  .branch-num {
    display: block;
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--karkadeh);
    margin-bottom: 0.5rem;
  }
  .branch-card h3 {
    font-size: 1.4rem;
    margin: 0 0 0.5rem;
  }
  .branch-card p {
    font-size: 0.92rem;
    margin: 0;
  }
  .go {
    display: inline-block;
    margin-top: auto;
    padding-top: 1rem;
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--river);
  }
  .branch-card:hover .go {
    color: var(--hibiscus);
  }

  @media (max-width: 1100px) {
    .branch-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .branch-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .branch-card {
      transition: none;
    }
  }
</style>
