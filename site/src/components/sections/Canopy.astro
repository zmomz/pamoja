---
// 05 · Canopy — What We Offer. Copy from the former /what-we-offer page; the
// canopy scene is ported from the prototype, recolored (river greens with an
// ochre light). Service cards open the shared popover with a compressed
// version of the former detail pages (draft protocol blocks filtered, same
// rule as before).
import { getServices, type Service } from '../../lib/data';
import { blockPlainText } from '../../lib/portableText';

const services = await getServices();

// The popover carries one plain-text paragraph, so the eight-section service
// template is compressed to its essentials: what it is, what to expect
// (discomfort included), what it is not, and the cultural protocols.
// Editorial placeholder blocks ("[Protocol wording…]") never render.
function popoverBody(service: Service): string {
  const expect = service.whatToExpect.map(blockPlainText).join(' ');
  const protocols = service.culturalProtocols
    .filter((b) => !blockPlainText(b).trim().startsWith('['))
    .map(blockPlainText)
    .join(' ');
  const not = service.whatThisIsNot.join(' ');
  return `${service.whatItIs} What to expect: ${expect} What this is not: ${not} Cultural protocols: ${protocols}`;
}
---

<section id="what-we-offer" class="journey" data-number="05" aria-labelledby="what-we-offer-title">
  <div class="art reveal">
    <div class="canopy-scene">
      <svg class="sway" viewBox="0 0 500 420" role="img" aria-label="Lush leafy canopy with light filtering through">
        <defs>
          <radialGradient id="canopy-grad-1" cx="0.4" cy="0.35" r="0.9">
            <stop offset="0" style="stop-color: var(--river-pale)" />
            <stop offset="0.6" style="stop-color: var(--river)" />
            <stop offset="1" style="stop-color: var(--river-deep)" />
          </radialGradient>
          <radialGradient id="canopy-grad-2" cx="0.35" cy="0.3" r="0.9">
            <stop offset="0" style="stop-color: var(--river-pale)" />
            <stop offset="0.6" style="stop-color: var(--river-light)" />
            <stop offset="1" style="stop-color: var(--river)" />
          </radialGradient>
          <radialGradient id="canopy-grad-3" cx="0.45" cy="0.3" r="0.9">
            <stop offset="0" style="stop-color: var(--river-light)" />
            <stop offset="0.6" style="stop-color: var(--river)" />
            <stop offset="1" style="stop-color: var(--river-deep)" />
          </radialGradient>
        </defs>

        <g class="grow g1" style="transform-origin: 250px 210px">
          <path d="M250 18 C315 16 370 58 380 120 C450 138 482 204 450 268 C474 328 424 384 356 376 C315 416 225 422 180 384 C100 396 35 352 40 284 C0 244 12 170 72 144 C82 76 160 22 250 18Z" fill="url(#canopy-grad-1)" />
        </g>
        <g class="grow g2" style="transform-origin: 145px 255px">
          <path d="M145 155 C185 150 225 175 235 220 C245 265 220 310 175 320 C130 330 85 305 75 260 C65 215 90 170 135 160 C138 158 142 156 145 155Z" fill="url(#canopy-grad-2)" opacity="0.92" />
        </g>
        <g class="grow g3" style="transform-origin: 368px 235px">
          <path d="M368 145 C408 140 448 165 458 210 C468 255 443 300 398 310 C353 320 308 295 298 250 C288 205 313 160 358 150 C361 148 365 146 368 145Z" fill="url(#canopy-grad-3)" opacity="0.9" />
        </g>
        <g class="grow g4" style="transform-origin: 250px 95px">
          <path d="M250 35 C285 33 315 55 320 90 C325 125 300 155 265 160 C230 165 200 140 195 105 C190 70 215 40 250 35Z" fill="url(#canopy-grad-2)" opacity="0.95" />
        </g>

        <g class="fade-in rustle rustle-b st-river-deep" fill="none" stroke-width="3" stroke-linecap="round" opacity="0.5">
          <path d="M120 220 C175 198 240 194 315 206" />
          <path d="M165 305 C230 280 305 274 370 284" />
          <path d="M220 125 C265 110 305 110 345 125" />
        </g>

        <g class="f-ochre-light" opacity="0.65">
          <path class="realistic-leaf" d="M180 180 C185 175 195 176 198 182 C193 188 185 187 180 182Z" />
          <path class="realistic-leaf rl2" d="M320 170 C325 165 335 166 338 172 C333 178 325 177 320 172Z" />
          <path class="realistic-leaf rl3" d="M280 280 C285 276 294 277 296 282 C292 287 285 286 280 282Z" />
          <path class="realistic-leaf" d="M140 260 C145 256 154 257 156 262 C152 267 145 266 140 262Z" />
          <path class="realistic-leaf rl2" d="M400 240 C405 236 414 237 416 242 C412 247 405 246 400 242Z" />
        </g>
      </svg>
    </div>
  </div>
  <div class="copy">
    <p class="tag reveal">05 · The canopy</p>
    <h2 class="reveal" data-d="1" id="what-we-offer-title">What We Offer</h2>
    <p class="reveal" data-d="2">
      On this page the usual roles invert. The expertise here is newcomer
      knowledge — carried, practised, and taught by the community's own
      knowledge holders. The learners are institutions: universities,
      municipal departments, non-profits. If your organization is ready to be
      taught rather than to consult, read on.
    </p>
    <a class="cta reveal" data-d="3" href="#contact">Start a conversation →</a>
  </div>

  <div class="protocol" style="grid-column: 1 / -1" aria-labelledby="protocol-heading">
    <p class="tag reveal">Before any service — how we work together</p>
    <h3 class="reveal" data-d="1" id="protocol-heading">The engagement protocol.</h3>
    <ol class="protocol-list">
      <li class="reveal" data-d="1">
        <h4>Build trust first</h4>
        <p>
          Ta'aruf takes time. Every engagement begins with coffee or tea,
          stories, and understanding — before agendas. If you are looking for
          a transaction, we are not the right partner. If you are looking for
          a relationship, you have come to the right tree.
        </p>
      </li>
      <li class="reveal" data-d="2">
        <h4>Respect the process</h4>
        <p>
          We acknowledge imbalances openly rather than pretend them away. We
          ask for patience with collective, consensus-based decision-making —
          it is slower than a chain of command and sturdier than one. And we
          share leadership and credit publicly, because that is how we work,
          not as a courtesy.
        </p>
      </li>
      <li class="reveal" data-d="3">
        <h4>A financial covenant</h4>
        <p>
          The Dish With One Spoon, in practice. Take only what you need.
          Leave something for others — fair honorariums for knowledge holders,
          staff pay, the operations that keep the work standing. Keep the dish
          clean: no extraction, and a commitment to long-term mutual thriving.
        </p>
      </li>
    </ol>
  </div>

  <div class="services" style="grid-column: 1 / -1" aria-labelledby="services-heading">
    <h3 class="reveal" id="services-heading">Three offerings.</h3>
    <p class="reveal" data-d="1">
      Each of these is taught by newcomer knowledge holders and learned by the
      institutions who engage them. The community practises; your
      organization is the guest.
    </p>
    <div class="service-grid">
      {services.map((service, i) => (
        <button
          type="button"
          class="service-card reveal"
          data-d={String((i % 4) + 1)}
          data-popover-title={service.title}
          data-popover-body={popoverBody(service)}
          data-popover-link="#contact"
          data-popover-link-text="Start a conversation →"
        >
          <span class="service-title">{service.title}</span>
          <span class="who">Taught by newcomer knowledge holders · Learned by your team</span>
          <span class="service-summary">{service.summary}</span>
          <span class="service-more">What engaging this actually involves</span>
        </button>
      ))}
    </div>
  </div>
</section>

<style>
  .canopy-scene {
    width: min(500px, 88vw);
  }

  .protocol h3,
  .services h3 {
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
    margin: 0 0 1rem;
  }
  .protocol-list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    counter-reset: step;
  }
  .protocol-list li {
    counter-increment: step;
    background: var(--white);
    border: 1px solid var(--line);
    border-left: 4px solid var(--ochre);
    border-radius: 18px;
    padding: 1.75rem 1.5rem;
  }
  .protocol-list li::before {
    content: counter(step, decimal-leading-zero);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--karkadeh);
    display: block;
    margin-bottom: 0.5rem;
  }
  .protocol-list h4 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 0 0 0.6rem;
    color: var(--night);
  }
  .protocol-list p {
    margin: 0;
    font-size: 0.98rem;
  }

  .service-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    margin-top: 2rem;
  }
  .service-card {
    display: flex;
    flex-direction: column;
    text-align: left;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 1.75rem 1.5rem;
    cursor: pointer;
    transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
  }
  .service-card:hover {
    transform: translateY(-4px);
    border-color: var(--river);
    box-shadow: 0 14px 28px color-mix(in srgb, var(--night) 10%, transparent);
  }
  .service-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    color: var(--karkadeh-deep);
    margin-bottom: 0.4rem;
  }
  .who {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--river-deep);
    margin-bottom: 0.9rem;
  }
  .service-summary {
    font-size: 0.98rem;
    line-height: 1.65;
  }
  .service-more {
    margin-top: auto;
    padding-top: 1rem;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--river);
  }
  .service-card:hover .service-more {
    color: var(--hibiscus);
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card {
      transition: none;
    }
  }
</style>
