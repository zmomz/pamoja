  </svg>
</div>

<style>
  .hero-tree {
    width: 100%;
  }
  .hero-tree svg {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Flat, cut shapes with a hand-drawn edge — the tree matches the
     wordmark's treatment (solid swatch fills, no airbrush, no drop
     shadow) so logo, type and illustration read as one system. */
  .crown-lobe {
    stroke: var(--river-deep);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }

  /* Token fills/strokes live in global.css (f-*, st-*), shared by all art. */

  /* Lit upper edge of each limb */
  .limb-hl {
    fill: none;
    stroke: var(--karkadeh);
    stroke-width: 2.5;
    stroke-linecap: round;
    opacity: 0.55;
  }
  #tree-roots .limb-hl {
    stroke: var(--ochre);
    stroke-width: 2;
    opacity: 0.3;
  }

  .tree-link > g {
    transition: filter 0.3s ease;
  }
  .tree-link:hover > g,
  .tree-link:focus-visible > g {
    filter: brightness(1.1);
  }
  .tree-link:focus-visible {
    outline: 3px solid var(--hibiscus);
    outline-offset: 4px;
  }

  /* Motes are part of the static drawing; the rise only plays when motion is welcome. */
  .mote {
    opacity: 0.55;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The one orchestrated moment (brief §7): scrolling out of the hero
       descends toward the ground — the soil sinks away, the crown lifts,
       the whole tree looms gently closer. Driven by --hero-p (0 → 1). */
    .hero-tree svg {
      transform: translateY(calc(var(--hero-p, 0) * 30px)) scale(calc(1 + var(--hero-p, 0) * 0.05));
      transform-origin: 50% 100%;
    }
    .layer-ground {
      transform: translateY(calc(var(--hero-p, 0) * 28px));
    }
    .layer-rise {
      transform: translateY(calc(var(--hero-p, 0) * -18px));
    }
    /* One idle motion for the hero: the crown sways. The motes are part of
       the still drawing. */
    .canopy-sway {
      transform-origin: 50% 90%;
      animation: ht-sway 12s ease-in-out infinite;
    }
  }

  @keyframes ht-sway {
    0%, 100% { transform: rotate(-0.7deg); }
    50% { transform: rotate(0.9deg); }
  }
</style>
