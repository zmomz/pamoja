          <g transform="translate(506 108)"><ellipse class="mote m4 f-hibiscus" rx="4.5" ry="7" transform="rotate(20)" /></g>
          <g transform="translate(150 210)"><path class="mote m5 f-river" d="M0 -5 C4 -2 4 2 0 5 C-4 2 -4 -2 0 -5 Z" /></g>
          <g transform="translate(580 190)"><path class="mote m6 f-river-light" d="M0 -5.5 C4.2 -2.2 4.2 2.2 0 5.5 C-4.2 2.2 -4.2 -2.2 0 -5.5 Z" /></g>
        </g>
