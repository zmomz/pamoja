---
// The whole Pamoja tree standing in its ground — the site's central asset.
// Every named part group is wrapped in a keyboard-focusable link to its
// journey anchor. Pure SVG + CSS; the scroll-linked descent is driven by the
// --hero-p custom property (set by the Hero script, no-preference only).
//
// Limbs (branches, twigs, roots) are tapered limb shapes generated from
// cubic centerlines with a flared base, so they grow out of the trunk and
// foot tangentially instead of being pinned on as fixed-width strokes.
---

<div class="hero-tree" id="hero-tree">
  <svg
    viewBox="0 0 720 800"
    preserveAspectRatio="xMidYMax meet"
    role="group"
    aria-labelledby="hero-tree-title hero-tree-desc"
  >
    <title id="hero-tree-title">The Pamoja tree</title>
    <desc id="hero-tree-desc">
      A hand-drawn tree standing in ground held in common. Its soil, roots, trunk,
      branches, canopy and seeds each lead to a part of the Pamoja story. Small
      seeds and leaf motes drift up and out from the canopy — the tree gives back
      to the ground that holds it.
    </desc>

    <defs>
      <radialGradient id="ht-sky" cx="0.5" cy="0.45" r="0.5">
        <stop offset="0" style="stop-color: var(--cream)" stop-opacity="0.85" />
        <stop offset="0.5" style="stop-color: var(--cream)" stop-opacity="0.3" />
        <stop offset="1" style="stop-color: var(--cream)" stop-opacity="0" />
      </radialGradient>
      {/* The soil mound: a lit ochre rim that sinks through karkadeh into
          exactly --karkadeh-deep, the color of the hero's ground shape, so
          the two read as one surface. */}
      <linearGradient id="ht-soil" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: var(--ochre)" />
        <stop offset="0.12" style="stop-color: var(--ochre)" stop-opacity="0.85" />
        <stop offset="0.42" style="stop-color: var(--karkadeh)" />
        <stop offset="0.78" style="stop-color: var(--karkadeh-deep)" />
        <stop offset="1" style="stop-color: var(--karkadeh-deep)" />
      </linearGradient>
      {/* Softens the mound's flanks into the page ground — no hard sides. */}
      <linearGradient id="ht-soil-fade" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#fff" stop-opacity="0" />
        <stop offset="0.24" stop-color="#fff" stop-opacity="1" />
        <stop offset="0.76" stop-color="#fff" stop-opacity="1" />
        <stop offset="1" stop-color="#fff" stop-opacity="0" />
      </linearGradient>
      <mask id="ht-soil-mask" maskUnits="userSpaceOnUse" x="-40" y="600" width="800" height="240">
        <rect x="-40" y="600" width="800" height="240" fill="url(#ht-soil-fade)" />
      </mask>
    </defs>

    {/* Sky warmth behind the crown */}
    <circle cx="360" cy="210" r="310" fill="url(#ht-sky)" opacity="0.6" />

    {/* Lower layer: the shared ground. It sinks on scroll; the tree — roots
        included — lifts as one body, so nothing pulls apart. */}
    <g class="layer-ground">
      <a href="#ground" class="tree-link" aria-label="Soil — The Ground We Share">
        <g id="tree-soil">
          <g mask="url(#ht-soil-mask)">
            {/* A low mound rising out of the page's ground; its flanks run
                off the canvas so there is no edge to see. */}
            <path
              d="M-30 800 C40 722 180 650 360 646 C540 650 680 722 750 800 Z"
              fill="url(#ht-soil)"
            />
            <path d="M-30 800 C40 722 180 650 360 646 C540 650 680 722 750 800" fill="none" class="st-ochre" stroke-width="4" stroke-linecap="round" opacity="0.7" />
            {/* Strata — quiet, horizontal, held in common */}
            <path d="M120 726 Q360 704 600 728" fill="none" class="st-ochre" stroke-width="3" stroke-linecap="round" opacity="0.32" />
            <path d="M150 766 Q360 750 570 768" fill="none" class="st-ochre" stroke-width="3" stroke-linecap="round" opacity="0.22" />
          </g>
          {/*
            Three marks in the soil at equal weight (brief §2): two parallel
            paths, one shared vessel, one ring — abstract forms of our own for
            the Two Row, the Dish With One Spoon, and the Charter. Never
            wampum imagery (§9.1).
          */}
          <g fill="none" class="st-cream" stroke-width="4" stroke-linecap="round" opacity="0.8">
            <path d="M150 740 Q204 728 258 740" />
            <path d="M150 760 Q204 748 258 760" />
            <path d="M312 744 L408 744" />
            <path d="M318 744 Q360 776 402 744" />
            <circle cx="540" cy="756" r="17" />
          </g>
          {/* Grass and stones along the mound */}
          <g fill="none" class="st-river" stroke-width="3" stroke-linecap="round" opacity="0.8">
            <path d="M126 690 l-5 -15 M135 689 l2 -18 M144 688 l7 -14" />
            <path d="M196 668 l-4 -13 M204 667 l4 -14" />
            <path d="M282 651 l-4 -13 M290 651 l4 -14" />
            <path d="M462 654 l-3 -12 M469 654 l4 -13" />
            <path d="M556 678 l-5 -15 M565 679 l2 -18 M574 681 l7 -14" />
          </g>
          <ellipse cx="216" cy="672" rx="10" ry="6" class="f-ochre" opacity="0.9" />
          <ellipse cx="516" cy="676" rx="8" ry="5" class="f-ochre" opacity="0.7" />
          {/* Contact shadow: a flat night wash where the foot presses in */}
          <ellipse cx="368" cy="670" rx="110" ry="14" class="f-night" opacity="0.22" />
        </g>
      </a>
    </g>

    {/* Rising layer: roots, branches (both drawn before the trunk so their
        flared bases tuck behind it), trunk, canopy, seeds */}
    <g class="layer-rise">
      <a href="#roots" class="tree-link" aria-label="Roots — Our Roots">
        <g id="tree-roots" class="f-karkadeh-deep">
