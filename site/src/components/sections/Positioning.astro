---
// The positioning band (brief §1.1): the argument the whole site makes,
// held on a dark band directly after the hero. Copy comes from the CMS
// homePage positioning statement; editorial placeholder blocks
// ("[Draft — …]") never render.
import { getHomePage } from '../../lib/data';
import { renderPortableText } from '../../lib/portableText';

const home = await getHomePage();

const positioningHtml = renderPortableText(
  home.positioningStatement.filter(
    (b) => !b.children.every((s) => s.text.trim().startsWith('['))
  )
);
---

<section class="positioning" aria-label="Who we are, in one breath">
  <div class="positioning-inner">
    <p class="tag reveal">The idea</p>
    <div class="positioning-body reveal" data-d="1" set:html={positioningHtml} />
  </div>
</section>

<style>
  .positioning {
    background: var(--night);
    color: var(--paper);
    padding: 15vh 8vw;
    /* A thin warm line eases the jump from the light hero. */
    border-top: 3px solid var(--ochre);
  }
  .positioning-inner {
    max-width: 1120px;
    margin-inline: auto;
  }
  .positioning .tag {
    color: var(--river-pale);
  }
  .positioning-body :global(p) {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.55rem, 2.9vw, 2.6rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    max-width: 30ch;
    margin: 0;
    color: var(--paper);
  }
  .positioning-body :global(p + p) {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.6;
    letter-spacing: 0;
    color: color-mix(in srgb, var(--cream) 82%, transparent);
    max-width: var(--max-prose);
    margin-top: 1.75rem;
  }
</style>
