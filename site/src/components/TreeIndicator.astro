---
import { SECTIONS, type SectionId } from '../lib/sections';

interface Props {
  currentSection?: SectionId;
  /** On the homepage, link to in-page anchors (#ground, …) instead of routes. */
  useAnchors?: boolean;
}

const { currentSection, useAnchors = false } = Astro.props;

const hrefFor = (s: (typeof SECTIONS)[number]) => (useAnchors ? s.anchor : s.path);
const currentFor = (s: (typeof SECTIONS)[number]) =>
  currentSection === s.id ? (useAnchors ? ('location' as const) : ('page' as const)) : undefined;
const cls = (s: (typeof SECTIONS)[number]) =>
  currentSection === s.id ? 'tree-part is-active' : 'tree-part';

const S = Object.fromEntries(SECTIONS.map((s) => [s.id, s]));
---

{/* Desktop rail — a miniature tree where every part is a link. */}
<nav class="tree-rail" aria-label="Where you are on the tree">
  <svg viewBox="0 0 120 250" width="76" role="group" aria-label="The Pamoja tree">
    {/* Soil — The Ground We Share */}
    <a href={hrefFor(S.ground)} class={cls(S.ground)} aria-label="Soil — The Ground We Share" aria-current={currentFor(S.ground)}>
      <g>
        <path class="part-shape" d="M6 214 Q60 202 114 214 L114 244 Q60 250 6 244 Z" fill="var(--soil)" />
        <circle class="active-dot" cx="10" cy="229" r="5" />
        <text class="part-label" x="124" y="229">Soil</text>
      </g>
    </a>
    {/* Roots — Our Roots */}
    <a href={hrefFor(S.roots)} class={cls(S.roots)} aria-label="Roots — Our Roots" aria-current={currentFor(S.roots)}>
      <g fill="none" stroke="var(--bark)" stroke-linecap="round">
        <path class="part-shape" d="M56 186 C42 200 30 208 18 215" stroke-width="6" />
        <path class="part-shape" d="M64 186 C78 200 90 208 102 215" stroke-width="6" />
        <path class="part-shape" d="M60 188 C58 202 58 210 60 219" stroke-width="5" />
        <circle class="active-dot" cx="10" cy="201" r="5" stroke="none" />
        <text class="part-label" x="124" y="201" stroke="none">Roots</text>
      </g>
    </a>
    {/* Trunk — Who We Are */}
    <a href={hrefFor(S['who-we-are'])} class={cls(S['who-we-are'])} aria-label="Trunk — Who We Are" aria-current={currentFor(S['who-we-are'])}>
      <g>
        <path class="part-shape" d="M53 192 C51 152 52 124 55 98 L65 98 C68 124 69 152 67 192 Z" fill="var(--bark)" />
        <circle class="active-dot" cx="10" cy="143" r="5" />
        <text class="part-label" x="124" y="143">Trunk</text>
      </g>
    </a>
    {/* Branches — Our Work */}
    <a href={hrefFor(S['our-work'])} class={cls(S['our-work'])} aria-label="Branches — Our Work" aria-current={currentFor(S['our-work'])}>
      <g fill="none" stroke="var(--bark)" stroke-linecap="round">
        <path class="part-shape" d="M56 114 C42 102 32 94 21 88" stroke-width="6" />
        <path class="part-shape" d="M64 112 C78 100 88 94 99 90" stroke-width="6" />
        <path class="part-shape" d="M58 98 C52 86 46 78 38 72" stroke-width="4" />
        <path class="part-shape" d="M63 98 C70 86 76 80 84 74" stroke-width="4" />
        <circle class="active-dot" cx="10" cy="90" r="5" stroke="none" />
        <text class="part-label" x="124" y="90" stroke="none">Branches</text>
      </g>
    </a>
    {/* Canopy — What We Offer */}
    <a href={hrefFor(S['what-we-offer'])} class={cls(S['what-we-offer'])} aria-label="Canopy — What We Offer" aria-current={currentFor(S['what-we-offer'])}>
      <g>
        <path class="part-shape" d="M60 12 C88 10 106 32 102 58 C98 84 80 96 60 94 C38 96 20 82 18 58 C16 32 34 14 60 12 Z" fill="var(--leaf)" />
        <path class="part-shape" d="M60 28 C79 26 91 41 89 58 C87 75 74 83 60 81 C45 83 33 73 31 58 C29 41 43 30 60 28 Z" fill="var(--leaf-deep)" opacity="0.8" />
        <circle class="active-dot" cx="10" cy="52" r="5" />
        <text class="part-label" x="124" y="52">Canopy</text>
      </g>
    </a>
    {/* Grove — Who We Grow With */}
    <a href={hrefFor(S['who-we-grow-with'])} class={cls(S['who-we-grow-with'])} aria-label="Grove — Who We Grow With" aria-current={currentFor(S['who-we-grow-with'])}>
      <g>
        <path class="part-shape" d="M20 178 L20 205" stroke="var(--bark)" stroke-width="4" stroke-linecap="round" />
        <circle class="part-shape" cx="20" cy="166" r="13" fill="var(--moss)" />
        <path class="part-shape" d="M100 180 L100 205" stroke="var(--bark)" stroke-width="4" stroke-linecap="round" />
        <circle class="part-shape" cx="100" cy="168" r="12" fill="var(--leaf-light)" />
        <circle class="active-dot" cx="10" cy="176" r="5" stroke="none" />
        <text class="part-label" x="124" y="176" stroke="none">Grove</text>
      </g>
    </a>
    {/* Seeds — Seeds */}
    <a href={hrefFor(S.seeds)} class={cls(S.seeds)} aria-label="Seeds — Seeds" aria-current={currentFor(S.seeds)}>
      <g>
        <ellipse class="part-shape" cx="38" cy="202" rx="6" ry="9" transform="rotate(-16 38 202)" fill="var(--coffee-cherry)" />
        <ellipse class="part-shape" cx="82" cy="204" rx="5" ry="8" transform="rotate(14 82 204)" fill="var(--tea)" />
        <circle class="active-dot" cx="10" cy="215" r="5" />
        <text class="part-label" x="124" y="215">Seeds</text>
      </g>
    </a>
  </svg>
</nav>

{/* Mobile chip — works without JS via details/summary. */}
<details class="tree-chip">
  <summary>
    <span class="chip-mark" aria-hidden="true"></span>
    On the tree
  </summary>
  <nav class="chip-panel" aria-label="Where you are on the tree">
    <ul>
      {SECTIONS.map((s) => (
        <li>
          <a
            href={hrefFor(s)}
            class:list={[{ 'is-active': currentSection === s.id }]}
            aria-current={currentFor(s)}
            aria-label={`${s.part} — ${s.label}`}
          >
            <span class="chip-part">{s.part}</span>
            <span class="chip-section">{s.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</details>

<script is:inline>
  (function () {
    var chip = document.querySelector('.tree-chip');
    if (!chip) return;
    chip.addEventListener('click', function (e) {
      if (e.target.closest('a')) chip.open = false;
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && chip.open) chip.open = false;
    });
  })();
</script>

<style>
  /* ---------- Desktop rail ---------- */
  .tree-rail {
    display: none;
  }
  @media (min-width: 1150px) {
    .tree-rail {
      display: block;
      position: fixed;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      z-index: 40;
      padding: 16px 10px;
      background: color-mix(in srgb, var(--paper) 88%, transparent);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid var(--line);
      border-radius: 44px;
      box-shadow: 0 10px 30px color-mix(in srgb, var(--soil-deep) 10%, transparent);
    }
  }
  .tree-rail svg {
    display: block;
    overflow: visible;
  }
  .tree-part {
    cursor: pointer;
  }
  .part-shape {
    transition: opacity 0.25s ease;
  }
  .tree-part:hover .part-shape,
  .tree-part:focus-visible .part-shape {
    opacity: 0.82;
  }
  .part-label {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 18px;
    fill: var(--ink);
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  .active-dot {
    fill: var(--coffee-cherry);
    stroke: var(--paper);
    stroke-width: 2;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  .tree-part:hover .part-label,
  .tree-part:focus-visible .part-label,
  .tree-part.is-active .part-label {
    opacity: 1;
  }
  /* Active part: an outline ring plus a dot plus the label —
     never colour alone. */
  .tree-part.is-active .part-shape {
    stroke: var(--soil-deep);
    stroke-width: 3;
    paint-order: stroke;
  }
  .tree-part.is-active .active-dot {
    opacity: 1;
  }

  /* ---------- Mobile chip ---------- */
  .tree-chip {
    position: fixed;
    right: 14px;
    bottom: 14px;
    z-index: 45;
    font-family: var(--font-ui);
  }
  .tree-chip summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    cursor: pointer;
    padding: 0.6rem 0.95rem;
    border-radius: 40px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--soil-deep) 16%, transparent);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--soil-deep);
  }
  .tree-chip summary::-webkit-details-marker {
    display: none;
  }
  .chip-mark {
    width: 14px;
    height: 14px;
    flex: none;
    background: var(--leaf);
    border-radius: 80% 10% 80% 10%;
    transform: rotate(-18deg);
  }
  .tree-chip[open] summary {
    background: var(--soil-deep);
    color: var(--paper);
    border-color: var(--soil-deep);
  }
  .chip-panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 10px);
    min-width: 230px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: 0 18px 44px color-mix(in srgb, var(--soil-deep) 22%, transparent);
    padding: 0.5rem;
  }
  .chip-panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .chip-panel a {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.5rem 0.7rem;
    border-radius: 12px;
    text-decoration: none;
    color: var(--ink);
  }
  .chip-panel a:hover {
    background: var(--paper-warm);
  }
  .chip-part {
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--soil);
    min-width: 4.6em;
  }
  .chip-section {
    font-family: var(--font-body);
    font-size: 0.95rem;
  }
  .chip-panel a.is-active {
    background: var(--paper-warm);
  }
  .chip-panel a.is-active::before {
    content: "";
    align-self: center;
    width: 0.55em;
    height: 0.55em;
    flex: none;
    border-radius: 50%;
    background: var(--coffee-cherry);
  }
  @media (min-width: 1150px) {
    .tree-chip {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .part-shape,
    .part-label,
    .active-dot {
      transition: none;
    }
  }
</style>
