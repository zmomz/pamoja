---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Positioning from '../components/sections/Positioning.astro';
import Ground from '../components/sections/Ground.astro';
import Roots from '../components/sections/Roots.astro';
import Trunk from '../components/sections/Trunk.astro';
import Branches from '../components/sections/Branches.astro';
import Archive from '../components/sections/Archive.astro';
import Canopy from '../components/sections/Canopy.astro';
import Grove from '../components/sections/Grove.astro';
import Seeds from '../components/sections/Seeds.astro';
import ContactSection from '../components/sections/ContactSection.astro';

const site = Astro.site ?? new URL('https://pamoja-collective.netlify.app');
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: 'Pamoja Cultural Collective',
  description:
    'A grassroots collective led by newcomer Canadians of African Muslim origin, building community on ethical common ground in Hamilton, Ontario.',
  url: site.href,
  areaServed: { '@type': 'City', name: 'Hamilton, Ontario' },
};
---

<Base
  title="Home"
  description="Pamoja Cultural Collective — a grassroots collective led by newcomer Canadians of African Muslim origin, building Hamilton together on ethical common ground. Pamoja means together."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />

  <Hero />
  <Positioning />
  <Ground />
  <Roots />
  <Trunk />
  <Branches />
  <Archive />
  <Canopy />
  <Grove />
  <Seeds />
  <ContactSection />
</Base>
