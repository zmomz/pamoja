---
import Base from '../layouts/Base.astro';
import HeroTree from '../components/home/HeroTree.astro';
import { getHomePage } from '../lib/data';
import { SECTIONS } from '../lib/sections';
import { renderPortableText } from '../lib/portableText';

const home = await getHomePage();

// The journey order (brief §3): whole tree → soil → roots → trunk → branches
// → canopy → grove → seeds. Passages come from the CMS, 40–80 words each.
const passages: Record<string, string> = {
  ground: home.ground,
  roots: home.roots,
  'who-we-are': home.whoWeAre,
  'our-work': home.ourWork,
  'what-we-offer': home.whatWeOffer,
  'who-we-grow-with': home.whoWeGrowWith,
  seeds: home.seeds,
};

// Editorial placeholder blocks ("[Draft — …]") never render.
const positioningHtml = renderPortableText(
  home.positioningStatement.filter((b) =>
    !b.children.every((s) => s.text.trim().startsWith('['))
  )
);

const site = Astro.site ?? new URL('https://pamoja-collective.netlify.app');
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: 'Pamoja Cultural Collective',
  description:
    'A grassroots collective led by newcomer Canadians of African Muslim origin, building community on ethical common ground in Hamilton, Ontario.',
  url: site.href,
  areaServed: { '@type': 'City', name: 'Hamilton, Ontario' },
};
---

<Base
  title="Home"
  description="Pamoja Cultural Collective — a grassroots collective led by newcomer Canadians of African Muslim origin, building Hamilton together on ethical common ground. Pamoja means together."
  currentSection="home"
  useAnchors
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />

  {/* 1. The whole tree — the hero (brief §5.1): the name, one line, nothing
      else competing. */}
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero-inner wrap">
      <div class="hero-words">
        <h1 id="hero-title">Pamoja<span aria-hidden="true">.</span></h1>
        <p class="hero-tagline">{home.heroTagline}</p>
      </div>
      <HeroTree />
    </div>
    <p class="scroll-cue" aria-hidden="true">Scroll — the journey starts in the ground</p>
  </section>

  {/* 2. The positioning (brief §1.1, short form): affirmative first, the
      explicit contrast below it. Real typographic weight, held for Abdo's
      final wording. */}
  <section class="positioning" aria-label="Who we are, in one breath">
    <div class="wrap" set:html={positioningHtml} />
  </section>

  {/* 3–9. The descent: one passage per part of the tree. */}
  <div class="journey wrap" id="journey">
    {SECTIONS.map((section) => (
      <section class="journey-stop" id={section.id} aria-labelledby={`${section.id}-title`}>
        <p class="tag">{section.part} · {section.label}</p>
        <h2 id={`${section.id}-title`}>{section.label}</h2>
        <p class="passage">{passages[section.id]}</p>
        <a class="journey-link" href={section.path}>
          The full page — {section.label.toLowerCase()} <span aria-hidden="true">→</span>
        </a>
      </section>
    ))}

    {/* 9. The invitation (brief §5.1): into What We Offer or Seeds. */}
    <section class="journey-invite" aria-label="Where to go next">
      <h2>Grow something with us.</h2>
      <p>
        If you are a university, a municipal department, or a non-profit ready
        to learn from the knowledge newcomers carry, begin with
        <a href="/what-we-offer">what we offer</a>. If you want to see where
        this is all heading — and what it takes to get there — read
        <a href="/seeds">what's growing</a>.
      </p>
    </section>
  </div>
</Base>

<script>
  // Two quiet enhancements, both gated on motion being welcome; the page is
  // complete without them (brief §3.5: a quieter version, not a broken one).
  const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

  // 1. The descent: --hero-p drives the HeroTree's scroll-linked transform.
  if (motionOk) {
    const tree = document.getElementById('hero-tree');
    const hero = document.querySelector<HTMLElement>('.hero');
    if (tree && hero) {
      let ticking = false;
      const update = () => {
        ticking = false;
        const range = hero.offsetHeight || 1;
        const p = Math.min(1, Math.max(0, window.scrollY / range));
        tree.style.setProperty('--hero-p', p.toFixed(3));
      };
      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };
      update();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }

  // 2. Scrollspy: reflect the current journey stop in the tree indicator.
  //    Runs regardless of motion preference — it is state, not animation.
  const stops = Array.from(document.querySelectorAll<HTMLElement>('.journey-stop[id]'));
  const indicatorLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.tree-rail a[href^="#"], .chip-panel a[href^="#"]')
  );
  if (stops.length && indicatorLinks.length && 'IntersectionObserver' in window) {
    const setActive = (id: string | null) => {
      for (const link of indicatorLinks) {
        const active = id !== null && link.getAttribute('href') === `#${id}`;
        link.classList.toggle('is-active', active);
        if (active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    };
    let visible = new Map<string, number>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.set(entry.target.id, entry.intersectionRatio);
          else visible.delete(entry.target.id);
        }
        let best: string | null = null;
        let bestRatio = 0;
        for (const [id, ratio] of visible) {
          if (ratio > bestRatio) {
            best = id;
            bestRatio = ratio;
          }
        }
        setActive(best);
      },
      { threshold: [0.25, 0.5, 0.75], rootMargin: '-15% 0px -35% 0px' }
    );
    stops.forEach((stop) => observer.observe(stop));
  }
</script>

<style>
  /* The hero opts out of the layout's header clearance and owns the full
     first viewport. */
  .hero {
    margin-top: -4.5rem;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 4.5rem;
    position: relative;
  }
  .hero-inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: 2rem;
  }
  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    }
  }
  .hero-words h1 {
    font-size: clamp(4rem, 11vw, 8.5rem);
    line-height: 0.98;
    margin: 0 0 0.5rem;
  }
  .hero-words h1 span {
    color: var(--coffee-cherry);
  }
  .hero-tagline {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 1.9rem);
    color: var(--ink-soft);
    margin: 0;
    max-width: none;
  }

  /* The positioning passage gets its own band directly after the hero —
     soil-deep ground, paper text, display face. It is the argument the whole
     site makes (brief §5.1). */
  .positioning {
    background: var(--soil-deep);
    color: var(--paper);
    padding-block: clamp(3.5rem, 10vh, 7rem);
  }
  .positioning :global(p) {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 2.1rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
    max-width: 30ch;
  }
  .positioning :global(p + p) {
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: var(--paper-warm);
    max-width: var(--max-prose);
    margin-top: 1.75rem;
  }
  .scroll-cue {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue {
      animation: cue-drift 2.8s ease-in-out infinite;
    }
    @keyframes cue-drift {
      0%, 100% { transform: translate(-50%, 0); }
      50% { transform: translate(-50%, 6px); }
    }
  }

  /* The journey stops. Generous vertical rhythm: each part of the tree gets
     its own breath as the visitor descends. */
  .journey {
    padding-block: var(--space-section);
  }
  .journey-stop {
    padding-block: clamp(3rem, 9vh, 6rem);
    max-width: var(--max-prose);
    scroll-margin-top: 5rem;
  }
  /* Soil first, but soil is low — alternate the indent on wide screens so
     the eye travels down and across rather than straight down a rail. */
  @media (min-width: 900px) {
    .journey-stop:nth-of-type(even) {
      margin-left: clamp(2rem, 12vw, 14rem);
    }
  }
  .journey-stop h2 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    margin: 0 0 1.25rem;
  }
  .passage {
    font-size: 1.1rem;
  }
  .journey-link {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--leaf-deep);
  }
  .journey-link:hover {
    color: var(--soil-deep);
  }

  .journey-invite {
    border-top: 1px solid var(--line);
    padding-block: var(--space-section);
    max-width: var(--max-prose);
  }
  .journey-invite h2 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    margin: 0 0 1rem;
  }
  .journey-invite p {
    font-size: 1.1rem;
  }
</style>
