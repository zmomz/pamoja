---
import Base from '../layouts/Base.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { getSiteSettings } from '../lib/data';

const settings = await getSiteSettings();
---

<Base
  title="Contact"
  description="Start a conversation with Pamoja Cultural Collective. We begin with coffee or tea and understanding before agendas — and we don't move fast."
  currentSection="contact"
>
  <section class="page-head wrap">
    <p class="tag">Contact</p>
    <h1>We start with a conversation.</h1>
    <p class="lede">
      And we don't move fast. Whether you're an institution hoping to learn,
      a funder considering an investment, or a neighbour with something to
      contribute — the first step is the same: sit down with us.
    </p>
    <p class="direct">
      Prefer email? Write to us at
      <a href={`mailto:${settings.contactEmail}`}>{settings.contactEmail}</a>.
    </p>
    {settings.socialLinks.length > 0 && (
      <ul class="social">
        {settings.socialLinks.map((link) => (
          <li>
            <a href={link.url} rel="noopener">{link.label}</a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="wrap inquiry-section" aria-labelledby="inquiry-heading">
    <h2 id="inquiry-heading">Tell us what you're hoping to build.</h2>
    <InquiryForm />
  </section>
</Base>

<style>
  .page-head {
    padding-block: 3rem 2rem;
  }
  .page-head h1 {
    font-size: clamp(2.6rem, 6.5vw, 5rem);
    margin: 0 0 1.25rem;
  }
  .lede {
    font-size: 1.2rem;
    max-width: var(--max-prose);
  }
  .direct {
    font-size: 1.1rem;
  }
  .social {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1rem 0 0;
    padding: 0;
    font-family: var(--font-ui);
    font-weight: 700;
  }
  .inquiry-section {
    padding-block: 1rem var(--space-section);
  }
</style>
