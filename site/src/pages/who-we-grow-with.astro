---
import Base from '../layouts/Base.astro';
import { getPartners, type Partner, type PartnerType } from '../lib/data';

const partners = await getPartners();

const groups: { type: PartnerType; heading: string; intro: string }[] = [
  {
    type: 'partner',
    heading: 'Partners',
    intro:
      'Organizations that build with Pamoja — co-creating gatherings, giving space, and sharing ground.',
  },
  {
    type: 'ally',
    heading: 'Allies',
    intro:
      'People and organizations who walk alongside the work without steering it.',
  },
  {
    type: 'funder',
    heading: 'Funders',
    intro:
      'Municipal, corporate, and arts funders whose support made specific gatherings possible.',
  },
];

const grouped = groups
  .map((group) => ({
    ...group,
    members: partners.filter((p) => p.type === group.type),
  }))
  .filter((group) => group.members.length > 0);

const settlementPartners = partners.filter(
  (p) => p.type === 'settlement-sector'
);
---

<Base
  title="Who We Grow With"
  description="The grove around the tree: partners, allies, and funders named with what they actually contributed — space, funding, teaching — plus the settlement organizations whose work makes Pamoja's possible."
  currentSection="who-we-grow-with"
>
  <section class="page-head wrap">
    <p class="tag">Grove · Who We Grow With</p>
    <h1>Who we grow with.</h1>
    <p class="lede">
      A tree doesn't grow alone. Around Pamoja stands a grove — partners,
      allies, and funders — each named here with what they actually
      contributed. Not a wall of logos: a record of relationships.
    </p>
  </section>

  {grouped.map((group) => (
    <section class="wrap grove-group" aria-labelledby={`group-${group.type}`}>
      <h2 id={`group-${group.type}`}>{group.heading}</h2>
      <p>{group.intro}</p>
      <ul class="partner-list">
        {group.members.map((partner: Partner) => (
          <li class="partner">
            <h3>
              {partner.url ? (
                <a href={partner.url} rel="noopener">{partner.name}</a>
              ) : (
                partner.name
              )}
            </h3>
            <p>{partner.contribution}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="wrap settlement" aria-labelledby="settlement-heading">
    <h2 id="settlement-heading">The settlement sector: distinct, not competing.</h2>
    <p>
      Elsewhere on this site we draw a clear line between Pamoja and
      settlement organizations. This is where we show the line is not a wall.
      Hamilton's settlement organizations do essential work — work that makes
      ours possible — and we collaborate with them respectfully. Their
      direction is services delivered to people who need them; ours is
      building the city with the people who carry its missing knowledge.
      Different directions, same city, no competition for the same ground.
    </p>

    {settlementPartners.length > 0 && (
      <ul class="partner-list">
        {settlementPartners.map((partner) => (
          <li class="partner">
            <h3>
              {partner.url ? (
                <a href={partner.url} rel="noopener">{partner.name}</a>
              ) : (
                partner.name
              )}
            </h3>
            <p>{partner.contribution}</p>
          </li>
        ))}
      </ul>
    )}

    <aside class="editor-note" role="note">
      <strong>Editorial placeholder.</strong> Names and wording for the
      settlement organizations we work alongside are to be supplied by Abdo
      before launch.
    </aside>
  </section>

  <section class="wrap closing">
    <p>
      If your organization belongs in this grove, the way in is the same as
      every other way in: <a href="/contact">a conversation</a>.
    </p>
  </section>
</Base>

<style>
  .page-head {
    padding-block: 3rem 2rem;
  }
  .page-head h1 {
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    margin: 0 0 1.25rem;
  }
  .lede {
    font-size: 1.2rem;
    max-width: var(--max-prose);
  }

  .grove-group {
    padding-block: 1.5rem;
  }
  .grove-group h2 {
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
  }

  .partner-list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
  }
  .partner {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 1.5rem;
  }
  .partner h3 {
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
  }
  .partner p {
    margin: 0;
    font-size: 0.98rem;
  }

  .settlement {
    padding-block: 2.5rem 2rem;
  }
  .settlement h2 {
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
  }

  .editor-note {
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    border: 2px dashed var(--clay);
    border-radius: 14px;
    font-family: var(--font-ui);
    font-size: 0.95rem;
    color: var(--soil);
    max-width: var(--max-prose);
  }

  .closing {
    padding-block: 1rem var(--space-section);
  }
  .closing p {
    font-size: 1.15rem;
  }
</style>
