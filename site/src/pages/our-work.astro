---
import Base from '../layouts/Base.astro';
import {
  getBranches,
  getEvents,
  sortEvents,
  type Event,
} from '../lib/data';

const branches = await getBranches();
const events = sortEvents(await getEvents());

function teaser(event: Event, maxLength = 200): string {
  const first = event.body.find((b) => b._type === 'block');
  if (!first) return '';
  const text = (first.children ?? []).map((c) => c.text).join('');
  if (text.length <= maxLength) return text;
  return text.slice(0, text.lastIndexOf(' ', maxLength)) + '…';
}

function statusBadge(event: Event): string {
  if (event.status === 'handed-on') {
    return event.handedOnTo
      ? `Handed on — now stewarded by ${event.handedOnTo.name}`
      : 'Handed on';
  }
  return event.status === 'upcoming' ? 'Upcoming' : 'Past';
}
---

<Base
  title="Our Work"
  description="Gatherings and public programs hosted and led by newcomer knowledge holders in Hamilton — connection, social cohesion, creative collaboration, and coordination, with the overlap left visible."
  currentSection="our-work"
>
  <section class="page-head wrap">
    <p class="tag">Branches · Our Work</p>
    <h1>Our work.</h1>
    <p class="lede">
      Everything Pamoja grows hangs off four branches. They overlap on
      purpose: an event can build connection, strengthen cohesion, deepen a
      partnership, and link existing efforts at the same time. The filter
      below shows the overlap rather than hiding it.
    </p>
  </section>

  <section class="wrap branch-grid" aria-label="The four branches of Pamoja's work">
    {branches.map((branch, i) => (
      <article class="branch-card">
        <p class="branch-num" aria-hidden="true">
          Branch {String(i + 1).padStart(2, '0')}
        </p>
        <h2>{branch.title}</h2>
        <p>{branch.description}</p>
        <a class="branch-link" href={`/our-work?serves=${branch.slug}`}>
          Gatherings that served {branch.title.toLowerCase()}
        </a>
      </article>
    ))}
  </section>

  <section class="wrap archive" id="archive" aria-labelledby="archive-heading">
    <p class="tag">Leaves &amp; fruit</p>
    <h2 id="archive-heading">Things we've grown.</h2>
    <p>
      Stories of hosting, teaching, making, gathering, and building together —
      not a tally of people helped. Most events belong to more than one
      branch; each card names the branches it served.
    </p>

    <div class="filters" role="group" aria-label="Filter gatherings by branch" id="filters">
      <a class="filter" href="/our-work" data-branch="all">All</a>
      {branches.map((branch) => (
        <a
          class="filter"
          href={`/our-work?serves=${branch.slug}`}
          data-branch={branch.slug}
        >
          {branch.title}
        </a>
      ))}
    </div>
    <p class="visually-hidden" role="status" id="filter-status">
      Showing all {events.length} gatherings.
    </p>

    <div class="events" id="events">
      {events.map((event) => (
        <article
          class="event-card"
          data-branches={event.branchesServed.map((b) => b.slug).join(' ')}
        >
          <p class="event-meta">{event.dateOrRange}</p>
          <span class:list={['badge', `badge-${event.status}`]}>
            {statusBadge(event)}
          </span>
          <h3>
            <a href={`/our-work/${event.slug}`}>{event.title}</a>
          </h3>
          <p class="teaser">{teaser(event)}</p>
          <ul class="branch-tags" aria-label="Branches this gathering served">
            {event.branchesServed.map((branch) => (
              <li>
                <a href={`/our-work?serves=${branch.slug}`}>{branch.title}</a>
              </li>
            ))}
          </ul>
          {event.partnersCredited.length > 0 && (
            <p class="credits">
              With {event.partnersCredited.map((p) => p.name).join(' · ')}
            </p>
          )}
        </article>
      ))}
    </div>

    <p class="quiet-line">
      Since 2023, Pamoja's community has hosted roughly 50 community
      gatherings and public programs, grown a network of seven-plus partners,
      and earned support from five municipal, corporate, and arts funders.
    </p>
  </section>
</Base>

<script is:inline>
  (function () {
    var filters = document.getElementById('filters');
    var eventsEl = document.getElementById('events');
    var status = document.getElementById('filter-status');
    if (!filters || !eventsEl || !status) return;

    var links = Array.prototype.slice.call(filters.querySelectorAll('a[data-branch]'));
    var cards = Array.prototype.slice.call(eventsEl.querySelectorAll('[data-branches]'));

    // Progressive enhancement: links become toggle controls. Without JS they
    // stay ordinary links and every event remains visible.
    links.forEach(function (link) {
      link.setAttribute('role', 'button');
    });

    function currentBranch() {
      var value = new URLSearchParams(window.location.search).get('serves');
      return value && links.some(function (l) { return l.dataset.branch === value; })
        ? value
        : 'all';
    }

    function apply(branch, updateUrl) {
      var count = 0;
      cards.forEach(function (card) {
        var show = branch === 'all' || card.dataset.branches.split(' ').indexOf(branch) !== -1;
        card.hidden = !show;
        if (show) count++;
      });
      links.forEach(function (link) {
        link.setAttribute('aria-pressed', String(link.dataset.branch === branch));
        link.classList.toggle('is-active', link.dataset.branch === branch);
      });
      status.textContent =
        branch === 'all'
          ? 'Showing all ' + count + ' gatherings.'
          : 'Showing ' + count + ' gathering' + (count === 1 ? '' : 's') + '.';
      if (updateUrl) {
        var url = branch === 'all' ? '/our-work' : '/our-work?serves=' + branch;
        window.history.replaceState(null, '', url);
      }
    }

    filters.addEventListener('click', function (event) {
      var link = event.target.closest('a[data-branch]');
      if (!link) return;
      event.preventDefault();
      apply(link.dataset.branch, true);
    });

    apply(currentBranch(), false);
  })();
</script>

<style>
  .page-head {
    padding-block: 3rem 2rem;
  }
  .page-head h1 {
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    margin: 0 0 1.25rem;
  }
  .lede {
    font-size: 1.2rem;
    max-width: var(--max-prose);
  }

  .branch-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    padding-block: 2rem 3rem;
  }
  .branch-card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 1.75rem 1.5rem;
  }
  .branch-num {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--soil);
    margin: 0 0 0.5rem;
  }
  .branch-card h2 {
    font-size: 1.5rem;
    margin: 0 0 0.75rem;
  }
  .branch-card p {
    font-size: 0.98rem;
  }
  .branch-link {
    margin-top: auto;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.92rem;
  }

  .archive {
    padding-block: 2rem var(--space-section);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0.5rem;
  }
  .filter {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.88rem;
    text-decoration: none;
    color: var(--soil-deep);
    background: var(--white);
    border: 1.5px solid var(--line);
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
  }
  .filter:hover {
    border-color: var(--clay);
  }
  .filter.is-active,
  .filter[aria-pressed='true'] {
    background: var(--soil-deep);
    color: var(--paper);
    border-color: var(--soil-deep);
  }

  .events {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    margin-top: 1.5rem;
  }
  .event-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 1.6rem 1.5rem;
  }
  .event-card[hidden] {
    display: none;
  }
  .event-meta {
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin: 0;
  }
  .badge {
    align-self: flex-start;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
  }
  .badge-upcoming {
    background: var(--leaf-deep);
    color: var(--paper);
  }
  .badge-past {
    background: var(--paper-warm);
    color: var(--soil);
    border: 1px solid var(--line);
  }
  .badge-handed-on {
    background: var(--soil-deep);
    color: var(--paper);
  }
  .event-card h3 {
    margin: 0;
    font-size: 1.3rem;
  }
  .event-card h3 a {
    color: var(--soil-deep);
    text-decoration-thickness: 1px;
  }
  .teaser {
    margin: 0;
    font-size: 0.98rem;
  }
  .branch-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.25rem 0 0;
    padding: 0;
  }
  .branch-tags a {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--leaf-deep);
    border: 1px solid var(--leaf-light);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
  }
  .branch-tags a:hover {
    background: var(--paper-warm);
  }
  .credits {
    margin: auto 0 0;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--line);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    color: var(--ink-soft);
  }

  .quiet-line {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
    color: var(--ink-soft);
    max-width: var(--max-prose);
  }
</style>
