---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found"
  description="This page has moved or never took root. Find your way back through the tree."
>
  <section class="wrap not-found">
    <p class="tag">404</p>
    <h1>This ground is unplanted.</h1>
    <p class="lede">
      The page you were looking for has moved, or never took root. The rest of
      the tree is still here — start again from
      <a href="/">the whole tree</a>, or go straight to
      <a href="/our-work">our work</a> or <a href="/contact">contact</a>.
    </p>
  </section>
</Base>

<style>
  .not-found {
    padding-block: var(--space-section);
  }
  .not-found h1 {
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    margin: 0 0 1.25rem;
  }
  .lede {
    font-size: 1.15rem;
    max-width: var(--max-prose);
  }
</style>
