---
import Base from '../layouts/Base.astro';
---

<Base
  title="Thank You"
  description="Your message has reached Pamoja Cultural Collective. We start with a conversation — we'll be in touch."
  currentSection="contact"
>
  <section class="wrap thank-you">
    <p class="tag">Thank you</p>
    <h1>The kettle is on.</h1>
    <p class="lede">
      Your message has reached us. We read everything together, and we reply
      as a collective — so it may take a little time. That's how trust gets
      built.
    </p>
    <p>
      <a href="/">Back to the tree →</a>
    </p>
  </section>
</Base>

<style>
  .thank-you {
    padding-block: 4rem var(--space-section);
  }
  h1 {
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    margin: 0 0 1.25rem;
  }
  .lede {
    font-size: 1.2rem;
    max-width: var(--max-prose);
  }
  p a {
    font-family: var(--font-ui);
    font-weight: 700;
  }
</style>
