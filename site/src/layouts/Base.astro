---
import '@fontsource/bricolage-grotesque/600.css';
import '@fontsource/bricolage-grotesque/700.css';
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/karla/400.css';
import '@fontsource/karla/700.css';
import '../styles/global.css';

import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import JourneyRail from '../components/JourneyRail.astro';
import Popover from '../components/Popover.astro';
import { getSiteSettings, sanityConfigured } from '../lib/data';
import { renderPortableText, blockPlainText } from '../lib/portableText';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Privacy-respecting analytics; also read from PUBLIC_PLAUSIBLE_DOMAIN. No GA. */
  plausibleDomain?: string;
}

const settings = await getSiteSettings();

const {
  title,
  description,
  ogImage,
  plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN ??
    (sanityConfigured ? settings.plausibleDomain : undefined),
} = Astro.props;

// Land acknowledgment (brief §9.5). Editorial placeholder blocks render as
// nothing — the footer appears once Abdo supplies the real wording.
const ackBlocks = (settings.landAcknowledgment ?? []).filter(
  (b) => !blockPlainText(b).trim().startsWith('[')
);
const landAcknowledgmentHtml = ackBlocks.length
  ? renderPortableText(ackBlocks)
  : undefined;

const pageTitle =
  title === 'Home'
    ? 'Pamoja Cultural Collective — Pamoja means together'
    : `${title} — Pamoja Cultural Collective`;

const site = Astro.site ?? new URL('https://pamoja-collective.netlify.app');
const canonicalUrl = new URL(Astro.url.pathname, site);
const ogImageUrl = new URL(ogImage ?? settings.ogDefaultImage?.url ?? '/brand/og-image.png', site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#822B2D" />

    {plausibleDomain && (
      <script is:inline defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>
    )}

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter landAcknowledgmentHtml={landAcknowledgmentHtml} contactEmail={settings.contactEmail} />
    {Astro.url.pathname === '/' && (
      <>
        <JourneyRail />
        <Popover />
      </>
    )}

    <script is:inline>
      // Shared motion for the single page. Everything visual is gated on
      // motion being welcome; scrollspy/rail state updates regardless.
      // Without JS: .reveal/.art children are simply visible and anchors
      // jump natively.
      (function () {
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Reveal-on-scroll (.reveal, stagger via data-d) and section art
        // choreography (.art gets .in, playing .draw/.grow/.fade-in).
        var revealEls = document.querySelectorAll('.reveal');
        var artEls = document.querySelectorAll('.art');
        if (reduceMotion || !('IntersectionObserver' in window)) {
          revealEls.forEach(function (el) { el.classList.add('in'); });
          artEls.forEach(function (el) { el.classList.add('in'); });
        } else {
          var revealObs = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) {
                en.target.classList.add('in');
                revealObs.unobserve(en.target);
              }
            });
          }, { threshold: 0.18 });
          revealEls.forEach(function (el) { revealObs.observe(el); });

          var artObs = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) {
                en.target.classList.add('in');
                artObs.unobserve(en.target);
              }
            });
          }, { threshold: 0.3 });
          artEls.forEach(function (el) { artObs.observe(el); });
        }

        // Smooth-scroll for in-page anchors, with focus moved to the target
        // so keyboard and screen-reader users land in the section.
        document.addEventListener('click', function (e) {
          var a = e.target.closest('a[href^="#"]');
          if (!a) return;
          var hash = a.getAttribute('href');
          if (!hash || hash.length < 2) return;
          var t = document.getElementById(hash.slice(1));
          if (!t) return;
          e.preventDefault();
          t.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
          history.pushState(null, '', hash);
          if (!t.hasAttribute('tabindex')) t.setAttribute('tabindex', '-1');
          t.focus({ preventScroll: true });
        });

        // Scrollspy: rail fill, rail stop positions and done/current state,
        // header active link, ghost-number intensify.
        var railStops = Array.prototype.slice.call(document.querySelectorAll('.rail-stop[data-stop]'));
        var chipLinks = Array.prototype.slice.call(document.querySelectorAll('.journey-chip a[data-stop]'));
        var headerLinks = Array.prototype.slice.call(document.querySelectorAll('.nav-desktop a[href^="#"]'));
        var fill = document.getElementById('rail-fill');

        var ids = [];
        railStops.forEach(function (el) {
          var id = el.getAttribute('data-stop');
          if (ids.indexOf(id) === -1) ids.push(id);
        });
        headerLinks.forEach(function (el) {
          var id = el.getAttribute('href').slice(1);
          if (ids.indexOf(id) === -1) ids.push(id);
        });
        var targets = ids
          .map(function (id) { return { id: id, el: document.getElementById(id) }; })
          .filter(function (s) { return s.el; });
        var journeySections = document.querySelectorAll('section.journey');

        function absTop(el) { return el.getBoundingClientRect().top + window.scrollY; }

        function updateJourney() {
          if (!targets.length) return;
          var vh = window.innerHeight;
          targets.sort(function (a, b) { return absTop(a.el) - absTop(b.el); });
          var top = absTop(targets[0].el);
          var last = targets[targets.length - 1].el;
          var bottom = absTop(last) + last.offsetHeight;
          var span = Math.max(1, bottom - top);
          var pos = window.scrollY + vh * 0.5;
          if (fill) {
            fill.style.transform = 'scaleY(' + Math.min(1, Math.max(0, (pos - top) / span)) + ')';
          }

          var currentIndex = -1;
          targets.forEach(function (s, i) {
            if (absTop(s.el) <= window.scrollY + vh * 0.45) currentIndex = i;
          });
          var currentId = currentIndex >= 0 ? targets[currentIndex].id : null;

          railStops.forEach(function (stop) {
            var id = stop.getAttribute('data-stop');
            var idx = -1;
            targets.forEach(function (s, i) { if (s.id === id) idx = i; });
            if (idx > -1) {
              var s = targets[idx];
              var frac = Math.min(1, Math.max(0, (absTop(s.el) + s.el.offsetHeight * 0.4 - top) / span));
              stop.style.top = (frac * 100) + '%';
            }
            stop.classList.toggle('is-done', idx > -1 && idx < currentIndex);
            stop.classList.toggle('is-current', idx === currentIndex);
            if (idx === currentIndex) stop.setAttribute('aria-current', 'location');
            else stop.removeAttribute('aria-current');
          });
          chipLinks.forEach(function (link) {
            var isCurrent = link.getAttribute('data-stop') === currentId;
            link.classList.toggle('is-current', isCurrent);
            if (isCurrent) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
          headerLinks.forEach(function (link) {
            var isActive = link.getAttribute('href') === '#' + currentId;
            link.classList.toggle('is-active', isActive);
            if (isActive) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
          journeySections.forEach(function (s) {
            var r = s.getBoundingClientRect();
            s.classList.toggle('in-view', r.top < vh * 0.6 && r.bottom > vh * 0.4);
          });
        }

        var ticking = false;
        window.addEventListener('scroll', function () {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(function () {
              ticking = false;
              updateJourney();
            });
          }
        }, { passive: true });
        window.addEventListener('resize', updateJourney);
        updateJourney();
      })();
    </script>
  </body>
</html>

<style>
  main {
    /* Clears the fixed header; the real homepage hero can opt out per-page. */
    padding-top: 4.5rem;
  }
</style>
