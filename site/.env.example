# Sanity project (create under a Pamoja-owned account at sanity.io, then fill these in)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Public site URL — set to the FINAL domain before launch (used for canonical
# links, sitemap, OG tags). The value below is the temporary test address.
PUBLIC_SITE_URL=https://pamoja-collective.netlify.app
# Contact inbox shown in the contact section and footer. Required before
# launch — without it the site falls back to a non-working placeholder.
PUBLIC_CONTACT_EMAIL=
# Only needed for the seed-import script (Sanity API token with write access). Never commit.
SANITY_WRITE_TOKEN=
